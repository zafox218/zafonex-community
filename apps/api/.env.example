NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL — matches docker-compose.yml
DATABASE_URL="postgresql://zafonex:zafonex_dev_password@localhost:5432/zafonex?schema=public"

# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Platform economics
PLATFORM_FEE_BPS=1000          # 1000 bps = 10% commission
WITHDRAWAL_MIN_USDT=20
CURRENCY=USDT

# USDT settlement (manual/TRC20 by default — no card processor required)
USDT_NETWORK=TRC20
USDT_DEPOSIT_ADDRESS=your_trc20_wallet_address
DEPOSIT_CONFIRMATIONS=19
